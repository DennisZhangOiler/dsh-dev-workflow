{
  "name": "@denniszhangoiler/dsh-rd-workflow",
  "version": "0.9.1",
  "description": "Mode-aware R&D Workflow agent preset for DeepSeek Harness: Light/Standard/Deep development, research, UI, and Program workflows.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "prompt.md",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "docs/*.md",
    "docs/screenshot-*.png",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "rd-workflow",
    "research",
    "ui-review",
    "subagents"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && node scripts/verify-e2e.mjs",
    "check": "node test/check.mjs",
    "test:smoke": "node test/smoke-temp-profile.mjs",
    "publish:npm": "npm publish --registry=https://registry.npmjs.org --access public",
    "publish:github": "npm publish --registry=https://npm.pkg.github.com --access public"
  },
  "author": "DennisZhangOiler",
  "homepage": "https://github.com/DennisZhangOiler/dsh-rd-workflow#readme",
  "bugs": {
    "url": "https://github.com/DennisZhangOiler/dsh-rd-workflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DennisZhangOiler/dsh-rd-workflow.git"
  },
  "dependencies": {
    "@denniszhangoiler/dsh-rd-workflow-client": "0.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
