{
  "name": "dsh-dev-workflow",
  "version": "0.2.0",
  "description": "Non-default Dev Workflow agent preset for DeepSeek Harness: a fixed ten-phase delivery pipeline with independent UI scoring, isolated testing, and read-only verification.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "prompt.md",
    "cordis.patch.yml",
    "skills",
    "locale/*.json",
    "docs",
    "test",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "dev-workflow",
    "ui-review",
    "subagents"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/plugin.test.mjs",
    "check": "node test/check.mjs",
    "test:smoke": "node test/smoke-temp-profile.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "DennisZhangOiler",
  "homepage": "https://github.com/DennisZhangOiler/dsh-dev-workflow#readme",
  "bugs": {
    "url": "https://github.com/DennisZhangOiler/dsh-dev-workflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DennisZhangOiler/dsh-dev-workflow.git"
  }
}
